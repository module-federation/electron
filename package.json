{
  "name": "mf-electron",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:package": "pnpm --filter @module-federation/electron build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc",
    "lint": "rslint",
    "lint:fix": "rslint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "smoke": "turbo run smoke",
    "check:publishable": "node scripts/check-publishable.mjs",
    "pack:electron": "pnpm --filter @module-federation/electron pack:dry"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.5",
    "@rslint/core": "^0.10.0",
    "@types/node": "^26.6.6",
    "jiti": "^2.7.0",
    "oxfmt": "0.75.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
