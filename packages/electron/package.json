{
  "name": "@module-federation/electron",
  "version": "0.1.0",
  "description": "Module Federation for Electron renderers built with Rsbuild or Vite",
  "keywords": [
    "electron",
    "micro-frontends",
    "module-federation",
    "rsbuild",
    "vite"
  ],
  "homepage": "https://github.com/module-federation/electron#readme",
  "bugs": {
    "url": "https://github.com/module-federation/electron/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/module-federation/electron.git",
    "directory": "packages/electron"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rsbuild": {
      "import": {
        "types": "./dist/rsbuild.d.ts",
        "default": "./dist/rsbuild.js"
      },
      "require": {
        "types": "./dist/rsbuild.d.cts",
        "default": "./dist/rsbuild.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build --lib cjs && rslib build --lib esm --no-clean",
    "dev": "rslib build --watch",
    "test": "rstest",
    "pack:dry": "npm pack --dry-run",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.9.3",
    "@module-federation/vite": "1.23.9",
    "@rsbuild/core": "2.3.0",
    "@rslib/core": "^1.0.5",
    "@rstest/core": "0.12.5",
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.3",
    "@module-federation/vite": "^1.23.9",
    "@rsbuild/core": "^2.0.0",
    "electron": ">=30",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@module-federation/rsbuild-plugin": {
      "optional": true
    },
    "@module-federation/vite": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
